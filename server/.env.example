# ===================================
# SERVER ENVIRONMENT VARIABLES
# ===================================

# Port to run the Express server on (defaults to 4000)
PORT=4000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/persona-ai?retryWrites=true&w=majority

# AI Model Configuration
# Use "gemini-2.5-flash" (or "gemini-1.5-flash") for Google Gemini
# Use "gpt-4o-mini" (or "gpt-4o") for OpenAI
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here

# Clerk Authentication Keys (Get from https://dashboard.clerk.com/)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Frontend Client URL (For CORS allowed origins)
CLIENT_URL=http://localhost:5173
