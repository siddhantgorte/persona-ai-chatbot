# ===================================
# CLIENT FRONTEND ENVIRONMENT VARIABLES
# ===================================

# Clerk Publishable Key (Must match the Clerk key used in server)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API Base URL
# Leave blank for local development (uses Vite proxy /api)
# Set to "https://your-render-backend.onrender.com" for production deployment on Vercel
VITE_API_BASE_URL=